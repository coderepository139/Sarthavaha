# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------- Launch settings (see the launch report) ----------------

# Google Analytics 4 measurement ID (build time). Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=""

# Show "Continue with phone number" (build time). Turn on only after enabling the
# Phone provider in Firebase Authentication (requires the Blaze plan).
VITE_ENABLE_PHONE_AUTH="false"

# Admin account used by the email/password admin login. Without ADMIN_PASSWORD the
# seeded admin gets an unusable random password.
ADMIN_EMAIL="admin@sarthavaha.com"
ADMIN_PASSWORD=""

# AI cost and load protection (per server instance; resets at midnight IST)
AI_DAILY_REQUEST_CAP="4000"        # all AI requests per day
AI_FREE_DAILY_REQUEST_CAP="2500"   # share available to free accounts
AI_PER_USER_PER_MINUTE="6"
AI_PER_IP_PER_MINUTE="20"
AUTH_PER_IP_PER_15_MIN="30"
AI_PAUSED="false"                  # set to "true" to stop all generation immediately

# ================= AdPilot console (/console, Netlify Functions) =================
# Set these in Netlify → Project configuration → Environment variables (Functions scope).

# Firebase service account (Firebase console → Project settings → Service accounts →
# Generate new private key). Paste the private key with its \n line breaks as-is.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# 64 hex characters; encrypts users' ad platform tokens. Never change it after launch.
APP_SECRET=""

# Claude API key for the AI agent
ANTHROPIC_API_KEY=""

# Exact site URL, used for OAuth redirect URIs (e.g. https://sarthavaha.com)
PUBLIC_URL=""

# "Connect with Meta": a Meta app with Facebook Login for Business + Marketing API
META_APP_ID=""
META_APP_SECRET=""

# "Connect with Google Ads": a Google Cloud OAuth client (Web) + your Google Ads developer token
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# "Connect with TikTok": a TikTok for Business developer app
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# Razorpay (₹999/month, ₹11,988/year after 5 free campaigns)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
